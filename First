import { redis } from '@/lib/redis/client';
import { downloadQueue } from '@/lib/queue';
import { rateLimit } from '@/lib/rate-limit';
import { isValidUrl, detectPlatform } from '@/lib/utils/helpers';
import { logger } from '@/lib/utils/logger';

const prisma = new PrismaClient();
const analyzeSchema = z.object({
  url: z.string().url(),
  platform: z.string().optional(),
});

export async function POST(req: NextRequest) {
  try {
    // Rate limiting
    const ip = req.headers.get('x-forwarded-for') || 'unknown';
    const limited = await rateLimit(ip, 'analyze');
    if (limited) {
      return NextResponse.json(
        { error: 'Rate limit exceeded. Please try again later.' },
        { status: 429 }
      );
    }

    // Parse and validate
    const body = await req.json();
    const { url, platform: clientPlatform } = analyzeSchema.parse(body);

    if (!isValidUrl(url)) {
      return NextResponse.json(
        { error: 'Invalid URL provided' },
        { status: 400 }
      );
    }

    // Detect platform (never trust client)
    const detectedPlatform = detectPlatform(url);
    
    if (detectedPlatform === 'UNKNOWN') {
      return NextResponse.json(
        { error: 'Unsupported platform. Please check the URL.' },
        { status: 400 }
      );
    }

    // Check if provider is configured
    if (!process.env.DOWNLOAD_PROVIDER_URL) {
      return NextResponse.json(
        { error: 'Media provider is not configured yet.' },
        { status: 503 }
      );
    }

    // Create job in database
    const job = await prisma.downloadJob.create({
      data: {
        sourceUrl: url,
        platform: detectedPlatform,
        status: 'PENDING',
        // If authenticated user, associate with user
      },
    });

    // Add to BullMQ queue
    await downloadQueue.add('download-video', {
      jobId: job.id,
      url,
      platform: detectedPlatform,
    });

    logger.info(`Job created: ${job.id} for ${detectedPlatform}`);

    return NextResponse.json({
      jobId: job.id,
      platform: detectedPlatform,
      status: job.status,
    });

  } catch (error) {
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        { error: 'Invalid request data' },
        { status: 400 }
      );
    }
    
    logger.error('Analyze error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}
import { Worker } from 'bullmq';
import { redis } from '@/lib/redis/client';
import { PrismaClient } from '@prisma/client';
import { getProvider } from '@/lib/providers';
import { logger } from '@/lib/utils/logger';
import { s3Storage } from '@/lib/storage/s3-storage';

const prisma = new PrismaClient();

const worker = new Worker(
  'download-queue',
  async (job) => {
    const { jobId, url, platform } = job.data;
    
    try {
      logger.info(`Processing job ${jobId}`);
      
      // Update status
      await prisma.downloadJob.update({
        where: { id: jobId },
        data: { status: 'PROCESSING' },
      });

      // Get provider
      const provider = getProvider(platform);
      if (!provider) {
        throw new Error(`No provider configured for ${platform}`);
      }

      // Process with provider
      const result = await provider.process(url);
      
      if (!result.success) {
        throw new Error(result.error || 'Provider processing failed');
      }

      // Generate temporary download URL
      const downloadUrl = await s3Storage.generateSignedUrl(
        result.fileKey,
        parseInt(process.env.DOWNLOAD_TTL_SECONDS || '3600')
      );

      // Update job
      await prisma.downloadJob.update({
        where: { id: jobId },
        data: {
          status: 'COMPLETED',
          downloadUrl,
          expiresAt: new Date(Date.now() + parseInt(process.env.DOWNLOAD_TTL_SECONDS || '3600') * 1000),
          metadata: result.metadata,
          quality: result.quality,
          format: result.format,
        },
      });

      // Create history entry if user exists
      // ...

      logger.info(`Job ${jobId} completed successfully`);

    } catch (error) {
      logger.error(`Job ${jobId} failed:`, error);
      
      await prisma.downloadJob.update({
        where: { id: jobId },
        data: {
          status: 'FAILED',
          error: error instanceof Error ? error.message : 'Unknown error',
        },
      });
      
      throw error;
    }
  },
  {
    connection: redis,
    concurrency: parseInt(process.env.QUEUE_CONCURRENCY || '5'),
    settings: {
      retryDelay: parseInt(process.env.QUEUE_RETRY_DELAY || '5000'),
      maxStalledCount: parseInt(process.env.QUEUE_RETRY_ATTEMPTS || '3'),
    },
  }
);

worker.on('completed', (job) => {
  logger.info(`Job ${job.id} completed`);
});

worker.on('failed', (job, err) => {
  logger.error(`Job ${job?.id} failed:`, err);
});

process.on('SIGTERM', async () => {
  await worker.close();
});

export default worker;


export interface ProviderResult {
  success: boolean;
  error?: string;
  fileKey?: string;
  downloadUrl?: string;
  metadata?: {
    title?: string;
    thumbnail?: string;
    duration?: string;
    author?: string;
  };
  quality?: string;
  format?: string;
  availableQualities?: string[];
  availableFormats?: string[];
}

export interface VideoProvider {
  process(url: string): Promise<ProviderResult>;
  getPlatform(): string;
}

export abstract class BaseProvider implements VideoProvider {
  abstract process(url: string): Promise<ProviderResult>;
  abstract getPlatform(): string;
  
  protected validateUrl(url: string): boolean {
    try {
      new URL(url);
      return true;
    } catch {
      return false;
    }
  }
  
  protected async fetchWithRetry(url: string, options: RequestInit = {}, maxRetries = 3): Promise<Response> {
    let lastError: Error | null = null;
    
    for (let i = 0; i < maxRetries; i++) {
      try {
        const response = await fetch(url, {
          ...options,
          headers: {
            'User-Agent': 'FastDownloader/1.0',
            ...options.headers,
          },
        });
        
        if (response.ok) {
          return response;
        }
        
        // Don't retry on client errors (4xx)
        if (response.status >= 400 && response.status < 500) {
          return response;
        }
        
        // Wait with exponential backoff
        await new Promise(resolve => setTimeout(resolve, Math.pow(2, i) * 1000));
      } catch (error) {
        lastError = error as Error;
      }
    }
    
    throw lastError || new Error('Max retries exceeded');
  }
}
