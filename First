import { redis } from '@/lib/redis/client';

interface RateLimitConfig {
  limit: number; // Number of requests
  window: number; // Time window in seconds
}

const defaultConfigs: Record<string, RateLimitConfig> = {
  analyze: {
    limit: parseInt(process.env.RATE_LIMIT_ANALYZE || '30'),
    window: 60,
  },
  download: {
    limit: parseInt(process.env.RATE_LIMIT_DOWNLOAD || '10'),
    window: 60,
  },
};

export async function rateLimit(
  identifier: string,
  type: 'analyze' | 'download',
  config?: RateLimitConfig
): Promise<boolean> {
  const cfg = config || defaultConfigs[type];
  const key = `ratelimit:${type}:${identifier}`;
  
  try {
    const current = await redis.get(key);
    const count = current ? parseInt(current) : 0;
    
    if (count >= cfg.limit) {
      return true; // Rate limited
    }
    
    // Increment and set expiry
    const pipeline = redis.pipeline();
    pipeline.incr(key);
    pipeline.expire(key, cfg.window);
    await pipeline.exec();
    
    return false;
  } catch (error) {
    console.error('Rate limit error:', error);
    return false; // Fail open on Redis errors
  }
}

export async function getRateLimitInfo(
  identifier: string,
  type: 'analyze' | 'download'
): Promise<{ remaining: number; limit: number; reset: number }> {
  const cfg = defaultConfigs[type];
  const key = `ratelimit:${type}:${identifier}`;
  
  try {
    const [count, ttl] = await Promise.all([
      redis.get(key).then(v => v ? parseInt(v) : 0),
      redis.ttl(key).then(v => v > 0 ? v : 0),
    ]);
    
    return {
      remaining: Math.max(0, cfg.limit - count),
      limit: cfg.limit,
      reset: Math.floor(Date.now() / 1000) + ttl,
    };
  } catch {
    return {
      remaining: cfg.limit,
      limit: cfg.limit,
      reset: Math.floor(Date.now() / 1000) + cfg.window,
    };
  }
}
