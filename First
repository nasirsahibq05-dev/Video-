export class YouTubeProvider extends BaseProvider {
  getPlatform(): string {
    return 'YOUTUBE';
  }
  
  async process(url: string): Promise<ProviderResult> {
    try {
      if (!this.validateUrl(url)) {
        return {
          success: false,
          error: 'Invalid YouTube URL',
        };
      }
      
      // Use the configured download provider API
      const apiUrl = process.env.DOWNLOAD_PROVIDER_URL;
      const apiKey = process.env.DOWNLOAD_PROVIDER_KEY;
      
      if (!apiUrl || !apiKey) {
        return {
          success: false,
          error: 'Download provider not configured',
        };
      }
      
      // Call the provider API
      const response = await this.fetchWithRetry(`${apiUrl}/api/download`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${apiKey}`,
        },
        body: JSON.stringify({
          url,
          platform: 'youtube',
        }),
      });
      
      if (!response.ok) {
        const error = await response.json().catch(() => ({}));
        return {
          success: false,
          error: error.message || `Provider error: ${response.status}`,
        };
      }
      
      const data = await response.json();
      
      // Map provider response to our format
      return {
        success: true,
        fileKey: data.fileKey || data.id,
        metadata: {
          title: data.title || 'Untitled',
          thumbnail: data.thumbnail,
          duration: data.duration,
