        availableFormats: data.formats || ['mp4', 'mp3'],
      };
      
    } catch (error) {
      logger.error('YouTube provider error:', error);
      return {
        success: false,
        error: error instanceof Error ? error.message : 'Processing failed',
      };
    }
  }

